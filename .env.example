# Variables de compilación de Astro (copia a .env; .env está en .gitignore)
# Clave PÚBLICA de Turnstile: debe ser del mismo widget que TURNSTILE_SECRET.
# En local el widget solo carga si 'localhost' está en los dominios del widget.
# Sin esta variable se usa la clave de pruebas (1x00...AA), que solo sirve con la secreta de pruebas.
PUBLIC_TURNSTILE_SITEKEY=0x_pon_aqui_tu_clave_publica
