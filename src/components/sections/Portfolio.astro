---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const total = sortedProjects.length;
---

<section id="portfolio" class="portfolio">
    <h2 class="heading">
        <span class="heading__span">Proyectos </span>Destacados
    </h2>

    <div class="portfolio-stack">
        {sortedProjects.map((project, index) => {
            const startScale = 1 + (total - 1 - index) * 0.025;
            return (
                <div
                    class="portfolio-sticky-card"
                    data-index={index}
                    data-start-scale={startScale.toFixed(4)}
                    style={{ top: `${index * 28}px` }}
                >
                    <div class="portfolio-sticky-card__outer">
                        <div class="portfolio-sticky-card__titlebar">
                            <div class="portfolio-sticky-card__dots">
                                <span class="portfolio-sticky-card__dot portfolio-sticky-card__dot--close"></span>
                                <span class="portfolio-sticky-card__dot portfolio-sticky-card__dot--minimize"></span>
                                <span class="portfolio-sticky-card__dot portfolio-sticky-card__dot--maximize"></span>
                            </div>
                            <span class="portfolio-sticky-card__window-title">
                                {project.data.title}
                            </span>
                        </div>
                        <div class="portfolio-sticky-card__body">
                            <a href={`/projects/${project.id}`} class="portfolio-sticky-card__link">
                                <div class="portfolio-sticky-card__image-col">
                                    <Image
                                        src={project.data.image}
                                        alt={project.data.title}
                                        class="portfolio-sticky-card__image"
                                        width={800}
                                        height={500}
                                    />
                                </div>
                                <div class="portfolio-sticky-card__info-col">
                                    <div class="portfolio-sticky-card__header">
                                        <span class="portfolio-sticky-card__number">
                                            {String(index + 1).padStart(2, "0")}
                                        </span>
                                        <span class="portfolio-sticky-card__category">
                                            {project.data.category}
                                        </span>
                                        <span class="portfolio-card__status" data-status={project.data.status}>
                                            {project.data.status}
                                        </span>
                                    </div>
                                    <h3 class="portfolio-sticky-card__title">
                                        {project.data.title}
                                    </h3>
                                    <p class="portfolio-sticky-card__description">
                                        {project.data.description}
                                    </p>
                                    <div class="portfolio-sticky-card__tags">
                                        {project.data.tags.slice(0, 4).map((tag: string) => (
                                            <span class="tag">#{tag}</span>
                                        ))}
                                    </div>
                                    <span class="portfolio-sticky-card__role">
                                        {project.data.role}
                                    </span>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            );
        })}
    </div>
</section>

<script>
    const cards = document.querySelectorAll(".portfolio-sticky-card");

    function updateScales() {
        const vh = window.innerHeight;
        cards.forEach((card) => {
            const rect = card.getBoundingClientRect();
            const index = parseInt(card.dataset.index);
            const startScale = parseFloat(card.dataset.startScale);
            const outer = card.querySelector(".portfolio-sticky-card__outer");

            const progressStart = vh;
            const progressEnd = index * 28;
            const progress = Math.max(0, Math.min(1,
                (progressStart - rect.top) / (progressStart - progressEnd),
            ));

            const scale = startScale - (startScale - 1) * progress;
            outer.style.transform = `scale(${scale})`;
        });
    }

    let ticking = false;
    window.addEventListener("scroll", () => {
        if (!ticking) {
            requestAnimationFrame(() => {
                updateScales();
                ticking = false;
            });
            ticking = true;
        }
    }, { passive: true });

    updateScales();
</script>
