---
import SkillCard from "@components/ui/SkillCard.astro";

const skillGroups = [
    {
        title: "Arquitectura & Backend",
        description: "Modelo de datos, lógica de negocio y APIs que no se caen.",
        skills: [
            "PHP (Laravel, MVC)",
            "WordPress Headless",
            "MySQL / PostgreSQL",
            "REST APIs",
            "Stripe",
            "WooCommerce",
            "PayPal",
            "Adquira (Bancomer)",
        ],
    },
    {
        title: "Frontend & Performance",
        description:
            "Que cargue rápido, se vea bien y no torture al usuario.",
        skills: [
            "Astro",
            "React",
            "TypeScript",
            "jQuery",
            "Tailwind CSS",
            "WordPress",
            "SEO Técnico",
            "Web Vitals Optimization",
        ],
    },
    {
        title: "DevOps & Automatización",
        description: "De mi máquina a producción sin sustos.",
        skills: [
            "Docker",
            "GitHub Actions",
            "CI/CD Pipelines",
            "Linux Admin",
            "SSH & Rsync",
            "Git Workflow",
        ],
    },
    {
        title: "Sistemas Geográficos (SIG)",
        description: "Mapas, coordenadas y datos que tienen dueño.",
        skills: [
            "GeoServer",
            "Leaflet",
            "PostGIS",
            "Manejo de datos espaciales",
        ],
    },
];
---

<section id="skills" class="skills">
    <div class="skills__container">
        <div class="skills__header">
            <h2 class="heading">
                <span class="heading__span">Stack </span>Tecnológico
            </h2>
            <p class="skills__description">
                No tengo martillo favorito. Para cada problema uso la herramienta
                que corresponde, y si no existe, la construyo.
            </p>
        </div>

        <div class="skills__grid">
            {skillGroups.map((group) => <SkillCard {...group} />)}
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const cards = document.querySelectorAll(
            ".js-skill-card",
        ) as NodeListOf<HTMLElement>;

        cards.forEach((card) => {
            card.addEventListener("mousemove", (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                card.style.setProperty("--mouse-x", `${x}px`);
                card.style.setProperty("--mouse-y", `${y}px`);
            });
        });
    });
</script>
