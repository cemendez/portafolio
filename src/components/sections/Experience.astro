---
import ExperienceCard from "@components/ui/ExperienceCard.astro";

const experiencias = [
    {
        company: "Secretaría de Planeación y Finanzas",
        role: "Arquitecto de Software / Tech Lead",
        date: "2023 - Presente",
        description:
            "Como arquitecto de software, lidero el diseño e implementación de la estrategia tecnológica institucional. Diseñé un Geoportal con arquitectura de servicios basada en GeoServer + OpenLayers que centralizó la consulta de información territorial, eliminando la dependencia de sistemas aislados. Implementé flujos de CI/CD con GitHub Actions que redujeron el tiempo de despliegue de horas a minutos, y arquitecté un sistema de monitoreo estatal de proyectos con roles y permisos granulares (RBAC) que hoy gestiona la trazabilidad de obras públicas en todo el estado. Administro la infraestructura Linux de producción y establezco los estándares técnicos que sigue el equipo de desarrollo.",
        tags: [
            "Laravel",
            "Astro",
            "React",
            "PostgreSQL",
            "Docker",
            "CI/CD (GitHub Actions)",
            "GeoServer",
            "OpenLayers",
            "RBAC",
            "Arquitectura de Servicios",
            "Linux Admin",
        ],
    },
    {
        company: "Agencia de Publicidad Unkonditional",
        role: "Arquitecto de Software Senior",
        date: "Marzo 2020 - Febrero 2023",
        description:
            "Diseñé la arquitectura de un sistema de pagos en línea para el Municipio de San Andrés Cholula, integrando la pasarela Adquira (Bancomer) con un modelo de datos que soportó la recaudación de impuestos prediales y de agua potable sin pérdida de registros. Para una plataforma E-Learning, arquitecté un sistema de suscripciones con Stripe, caché de cursos y generación automatizada de certificados PDF, manejando concurrencia de cientos de usuarios simultáneos. También diseñé una API headless sobre WordPress que alimentaba un frontend optimizado, mejorando los tiempos de carga en un 40% respecto al sitio anterior. Estandaricé el flujo de trabajo Git y los procesos de code review del equipo.",
        tags: [
            "Laravel",
            "MySQL",
            "SQL Server",
            "Stripe",
            "WordPress Headless",
            "Diseño de APIs",
            "Payments Architecture",
        ],
    },
    {
        company: "Secretaría de Planeación y Finanzas",
        role: "Desarrollador Full Stack / Arquitecto en formación",
        date: "Agosto 2017 - Marzo 2020",
        description:
            "Diseñé e implementé el primer portal de Georeferenciación de Obras Públicas del estado, sentando las bases arquitectónicas de lo que después sería el ecosistema SIG institucional. Creé un modelo de datos geoespacial con PostGIS + GeoServer que permitió visualizar por primera vez en un mapa interactivo los proyectos estatales, integrando capas municipales y regionales. Desarrollé las plataformas de seguimiento del Plan Estatal de Desarrollo y los Informes de Gobierno, aplicando principios de normalización de datos que redujeron la redundancia en un 60%. Configuré la infraestructura de servidores Linux y MacOS para producción, estableciendo protocolos de backup y monitoreo.",
        tags: [
            "PHP",
            "MySQL",
            "PostGIS",
            "GeoServer",
            "Leaflet",
            "Arquitectura de Datos",
            "Linux Admin",
        ],
    },
    {
        company: "Freelance",
        role: "Desarrollador Web / Consultor Técnico",
        date: "2014 - 2017",
        description:
            "Como consultor independiente, diseñé y desarrollé sitios web, tiendas en línea y sistemas administrativos para PYMEs. Seleccioné la pila tecnológica adecuada para cada proyecto (WordPress, PHP nativo o soluciones a medida) basándome en los requisitos de escalabilidad, presupuesto y tiempo del cliente. Implementé integraciones de pago, paneles administrativos a medida y estrategias de SEO técnico. Esta etapa me dio una visión integral del negocio del software: entender las necesidades reales del cliente, priorizar funcionalidades y entregar soluciones funcionales en entornos con recursos limitados.",
        tags: [
            "PHP",
            "MySQL",
            "WordPress",
            "WooCommerce",
            "Arquitectura para PYMEs",
        ],
