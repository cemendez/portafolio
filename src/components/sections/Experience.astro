---
import ExperienceCard from "@components/ui/ExperienceCard.astro";

const experiencias = [
    {
        company: "Secretaría de Planeación y Finanzas",
        role: "Arquitecto de Software / Tech Lead",
        date: "2023 - Presente",
        description:
            "Lidero la estrategia tecnológica de la institución. Diseñé un Geoportal con GeoServer + OpenLayers que centralizó información territorial que antes estaba dispersa en sistemas aislados. Implementé CI/CD con GitHub Actions: lo que antes tomaba horas ahora pasa en minutos. También arquitecté un sistema de monitoreo de proyectos con RBAC que hoy da trazabilidad a todas las obras públicas del estado. Además, administro los servidores Linux de producción y defino los estándares técnicos que sigue el equipo.",
        tags: [
            "Laravel",
            "Astro",
            "React",
            "PostgreSQL",
            "Docker",
            "CI/CD (GitHub Actions)",
            "GeoServer",
            "OpenLayers",
            "RBAC",
            "Arquitectura de Servicios",
            "Linux Admin",
        ],
    },
    {
        company: "Agencia de Publicidad Unkonditional",
        role: "Arquitecto de Software Senior",
        date: "Marzo 2020 - Febrero 2023",
        description:
            "Diseñé la arquitectura de un sistema de pago predial para San Andrés Cholula, integrando Adquira (Bancomer) con un modelo de datos que soportó la recaudación de impuestos sin perder un solo registro. Para una plataforma E-Learning, monté un sistema de suscripciones con Stripe, caché de cursos y certificados PDF automatizados, todo aguantando cientos de usuarios concurrentes. También construí una API headless sobre WordPress que alimentaba un frontend optimizado, logrando un 40% más de velocidad que el sitio anterior. De paso, estandaricé el Git workflow y los code reviews del equipo.",
        tags: [
            "Laravel",
            "MySQL",
            "SQL Server",
            "Stripe",
            "WordPress Headless",
            "Diseño de APIs",
            "Payments Architecture",
        ],
    },
    {
        company: "Secretaría de Planeación y Finanzas",
        role: "Desarrollador Full Stack / Arquitecto en formación",
        date: "Agosto 2017 - Marzo 2020",
        description:
            "Construí el primer portal de Georeferenciación de Obras Públicas del estado. Nadie había visto antes los proyectos estatales en un mapa interactivo. Diseñé un modelo de datos geoespacial con PostGIS + GeoServer que integró capas municipales y regionales por primera vez. También desarrollé las plataformas de seguimiento del Plan Estatal de Desarrollo y los Informes de Gobierno, normalizando datos y reduciendo la redundancia en un 60%. Configuré los servidores Linux y MacOS de producción, con backups y monitoreo que antes no existían.",
        tags: [
            "PHP",
            "MySQL",
            "PostGIS",
            "GeoServer",
            "Leaflet",
            "Arquitectura de Datos",
            "Linux Admin",
        ],
    },
    {
        company: "Freelance",
        role: "Desarrollador Web / Consultor Técnico",
        date: "2014 - 2017",
        description:
            "Como consultor independiente, hacía de todo: sitios web, tiendas en línea, sistemas administrativos para PYMEs. Elegía la tecnología con base en lo que el cliente necesitaba, no en lo que yo quería aprender. Implementé pasarelas de pago, paneles a medida y SEO técnico en proyectos con presupuestos ajustados y fechas reales. Esa etapa me enseñó algo que no se aprende en la teoría: el software funciona cuando resuelve el problema de alguien, no cuando usa la tecnología más moderna.",
        tags: [
            "PHP",
            "MySQL",
            "WordPress",
            "WooCommerce",
            "Arquitectura para PYMEs",
        ],
    },
];
---

<section class="experience" id="experience">
    <h2 class="heading">
        <span class="heading__span">Experiencia </span>laboral
    </h2>

    <div class="experience__list">
        {experiencias.map((exp) => <ExperienceCard {...exp} />)}
    </div>
</section>
