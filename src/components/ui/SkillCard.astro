---
import { getTechIcon } from "./techIcons";

interface Props {
    title: string;
    skills: string[];
}

const { title, skills } = Astro.props;
---

<div class="skills__column">
    <h3 class="skills__column-title">{title}</h3>
    <div class="skills__tags">
        {skills.map((skill) => (
            <span class="skills__tag">
                <Fragment set:html={getTechIcon(skill)} />
                {skill}
            </span>
        ))}
    </div>
</div>
