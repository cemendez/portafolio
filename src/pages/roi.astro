---
import "@assets/css/roi.css";
import RoiCalculator from "@components/roi/RoiCalculator.astro";
import { getImage } from "astro:assets";
import MainLayout from "@layouts/MainLayout.astro";
import cover from "@content/lab/assets/images/calculadora-roi-portada.webp";

const title = "Calculadora de ROI: ¿cuánto te cuesta no automatizar?";
const description =
    "Calcula cuánto tiempo y dinero pierde tu negocio por procesos manuales y en cuántos meses se recupera la inversión, con pago único o plan mensual.";

// og:image: la misma portada de la ficha del laboratorio, en JPG 1200x630
const ogImage = await getImage({
    src: cover,
    width: 1200,
    height: 630,
    fit: "cover",
    position: "top",
    format: "jpeg",
    quality: 80,
});

const pageUrl = new URL("/roi", Astro.site).href;
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Inicio",
            item: Astro.site?.href,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Calculadora de ROI",
            item: pageUrl,
        },
    ],
};

const preguntas = [
    "¿Cuántas horas a la semana pasa tu equipo capturando, confirmando o persiguiendo datos que ya existen en otro lado?",
    "¿Cuántas citas o clientes pierdes al mes por un olvido, un mensaje sin responder o un seguimiento que no se hizo?",
    "¿Qué haces cada mes en Excel que siempre es igual y te quita más tiempo del que quisieras?",
    "¿Qué pasa con tu negocio si la persona que «sabe cómo funciona todo» se ausenta una semana?",
    "¿Cuánto vale para ti recuperar un día completo de trabajo cada semana?",
];
---

<MainLayout
    title={title}
    description={description}
    image={ogImage.src}
    imageAlt="Formulario de la calculadora de ROI con los precios de pago único y plan mensual"
    imageWidth={1200}
    imageHeight={630}
>
    <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
    />
    <section class="roi" id="roi">
        <div class="roi__container">
            <nav class="roi-breadcrumb" aria-label="Ruta">
                <a href="/#home">Inicio</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">Calculadora de ROI</span>
            </nav>

            <header class="roi__header">
                <h1 class="roi__title">¿Cuánto te cuesta no automatizar?</h1>
                <p class="roi__intro">
                    Antes de hablar de precio, hablemos de números. Responde
                    estas preguntas y calcula cuánto tiempo y dinero podrías
                    recuperar, y en cuántos meses se paga la inversión.
                </p>
            </header>

            <ul class="roi__preguntas">
                {preguntas.map((pregunta) => (
                    <li>{pregunta}</li>
                ))}
            </ul>

            <RoiCalculator />
        </div>
    </section>
</MainLayout>
