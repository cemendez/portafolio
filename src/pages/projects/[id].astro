---
import "@assets/css/project-details.css";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import MainLayout from "@layouts/MainLayout.astro";
import VideoEmbed from "@components/ui/VideoEmbed.astro";
import { videoObject } from "@utils/video";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { data, id } = project;
const { Content } = await render(project);

// og:image: JPG 1200x630 (los scrapers sociales no siempre soportan webp)
// en lugar de la imagen original completa
const ogImage = await getImage({
    src: data.image,
    width: 1200,
    height: 630,
    fit: "cover",
    position: "top",
    format: "jpeg",
    quality: 80,
});

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const publishedLabel = data.publishDate.toLocaleDateString("es-MX", {
    year: "numeric",
    month: "long",
    timeZone: "UTC",
});

// Datos estructurados propios de cada proyecto (el Person global va en el layout)
const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "CreativeWork",
        name: data.title,
        description: data.description,
        url: pageUrl,
        image: new URL(ogImage.src, Astro.site).href,
        datePublished: data.publishDate.toISOString(),
        keywords: data.tags.join(", "),
        inLanguage: "es-MX",
        author: {
            "@type": "Person",
            name: "Carlos Emmanuel Méndez Calderón",
            url: Astro.site?.href,
        },
    },
    ...(data.youtubeId
        ? [
              videoObject({
                  id: data.youtubeId,
                  name: `Recorrido de ${data.title}`,
                  description: data.description,
                  uploadDate: data.videoDate ?? data.publishDate,
              }),
          ]
        : []),
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                name: "Inicio",
                item: Astro.site?.href,
            },
            {
                "@type": "ListItem",
                position: 2,
                name: data.title,
                item: pageUrl,
            },
        ],
    },
];
---

<MainLayout
    title={`${data.title} | Portafolio`}
    description={data.description}
    image={ogImage.src}
    imageAlt={`Captura del proyecto ${data.title}`}
    imageWidth={1200}
    imageHeight={630}
    type="article"
    publishedTime={data.publishDate}
>
    <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
    />
    <article class="project-details">
        <div class="project-details__container">
            <a href="/#portfolio" class="project-details__back">
                ← Volver al inicio
            </a>

            <header class="project-details__header">
                <h1 class="project-details__title">{data.title}</h1>
                <div class="project-details__meta">
                    <span class="project-details__badge">
                        <strong>Rol:</strong> {data.role}
                    </span>
                    <span class="project-details__badge">
                        <strong>Categoría:</strong>
                        {data.category}
                    </span>
                    <span class="project-details__badge">
                        <strong>Estado:</strong> {data.status}
                    </span>
                    <span class="project-details__badge">
                        <strong>Publicado:</strong> {publishedLabel}
                    </span>
                </div>

                <ul class="project-details__tags" aria-label="Tecnologías">
                    {data.tags.map((tag) => (
                        <li class="project-details__tag">{tag}</li>
                    ))}
                </ul>

                {(data.demoUrl || data.repoUrl) && (
                    <div class="project-details__links">
                        {data.demoUrl && (
                            <a
                                href={data.demoUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="project-details__link"
                            >
                                Ver demo
                            </a>
                        )}
                        {data.repoUrl && (
                            <a
                                href={data.repoUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="project-details__link project-details__link--secondary"
                            >
                                Ver repositorio
                            </a>
                        )}
                    </div>
                )}
            </header>

            <Image
                src={data.image}
                width={900}
                transition:name={`img-${id}`}
                class="project-details__image"
                alt={data.title}
            />

            {data.youtubeId && (
                <VideoEmbed
                    id={data.youtubeId}
                    title={`Recorrido de ${data.title}`}
                />
            )}

            <div class="project-details__content">
                <Content />
            </div>
        </div>
    </article>
</MainLayout>
