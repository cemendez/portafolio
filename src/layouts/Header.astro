            class="header__logo-img"
            viewBox="0 0 300 300"
            width="60"
            height="60"
            role="img"
            aria-label="Logo de mi portafolio Web (Carlos Méndez)"
        >
            <style>
                .logo-bracket { fill: var(--logo-primary, #f1f5f9); }
                .logo-spiral { fill: var(--logo-accent, #00aaee); }
                .logo-dot    { fill: var(--logo-accent, #00aaee); }
            </style>
